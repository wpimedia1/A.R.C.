# Copy to .env (git-ignored). Never commit keys.
# The mission system reads one model credential: MODEL_API_KEY, from this file first,
# then the process environment. No other variable names are used and there is no offline mode.
# Get the key from the Meta developer dashboard for the account whose usage you will check.
MODEL_API_KEY=
# Operator token for the local launcher (start.bat): only a request carrying it can start the public mission.
# Docker reads MISSION_OPERATOR_TOKEN from .env in the repository root instead.
MISSION_OPERATOR_TOKEN=
