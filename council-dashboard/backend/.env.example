# Copy to .env and fill in. .env is git-ignored; never commit keys.
#
# STAGE 1 (no keys needed): set COUNCIL_OFFLINE=1 below. The app boots,
# the dashboard loads, and replay runs the full pipeline on labeled
# rehearsal data.
# STAGE 2 (live): add your keys, remove the COUNCIL_OFFLINE line.
OPEN_BASE_URL=https://api.meta.ai/v1
OPEN_API_KEY=
OPEN_MODEL=muse-spark-1.3
# Blank SMART_* inherits OPEN_*; fill SMART_* only for separate anchors.
SMART_BASE_URL=
SMART_API_KEY=
SMART_MODEL=muse-spark-1.3
# Media tiers default to the Meta host; they reuse your key below.
# VOICE_BASE_URL=https://api.meta.ai
# VOICE_API_KEY=
# SAM_BASE_URL=https://api.meta.ai
# SAM_API_KEY=
# IMAGE_BASE_URL=https://api.meta.ai
# IMAGE_API_KEY=
# IMAGE_MODEL=muse-image-1.0
# WONDER_BASE_URL=https://api.meta.ai/v1
# WONDER_API_KEY=
# WONDER_MODEL=muse-wonder-1.0
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=muse-image-1.0
COUNCIL_SEED=7
# COUNCIL_OFFLINE=1
