# Copy to .env in the repository root (git-ignored). Never commit the filled-in file.
# Public hostname that points at this server (A/AAAA record). Caddy obtains the HTTPS certificate.
DOMAIN=
# Database password; generate one, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=
# Meta Model API key (read by the worker only).
MODEL_API_KEY=
# Agents: meta (Meta models) or fixed-priority (no model calls).
MISSION_MODEL_MODE=meta
# Spending limits in USD for model calls. Visitor experiments default to 0 (visitors cannot spend your credits).
# Public mission limits are unset by default (accounting only); set them to cap daily/monthly spend.
MISSION_VISITOR_DAILY_LIMIT_USD=0
MISSION_VISITOR_MONTHLY_LIMIT_USD=0
MISSION_PUBLIC_DAILY_LIMIT_USD=
MISSION_PUBLIC_MONTHLY_LIMIT_USD=
